# flood.sub - NFS Bypass Version

# 1. Use the wrapper script as the executable
executable = run.sh

# 2. Pass the python script name as an argument to the wrapper
arguments = $(script_name)

# 3. Enable transfer to bypass the FileSystemDomain check
should_transfer_files = NO
when_to_transfer_output = ON_EXIT

# 4. Standard Resources
request_cpus = 1
request_memory = 512MB
request_disk = 512MB

# 5. Logs
log = $(job_name).log
output = $(job_name).out
error = $(job_name).err

queue