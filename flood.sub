# This submit file runs jobs on HTCondor without relying on file transfer for large datasets

# Executable script to run
executable = run.sh
# Pass the script name as an argument to the executable
arguments = $(script_name)

# Enable HTCondor's file transfer mechanism
should_transfer_files = YES
# Transfer output files back when the job completes
when_to_transfer_output = ON_EXIT

# Don't transfer input files since we're using absolute NFS paths
# This prevents HTCondor from attempting to transfer large data files
transfer_input_files = ""

# Resource requests
request_cpus = 1          
request_memory = 512MB    
request_disk = 512MB      

# Job logging and output files (variables set elsewhere)
log = $(job_name).log     
output = $(job_name).out  
error = $(job_name).err   

# Machine requirements: Linux on x86_64 architecture only
requirements = (TARGET.Arch == "X86_64") && (TARGET.OpSys == "LINUX")

# Submit the job to the queue
queue