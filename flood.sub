# flood.sub - Generic submit file
# Executable is python3, arguments is the script name passed from DAG
# flood.sub - NFS shared workspace version

executable = /mnt/data/Flood_predictor/venv/bin/python
arguments = $(script_name)
initialdir = /mnt/data/flood_predictor
should_transfer_files = NO

request_cpus = 1
request_memory = 512MB
request_disk = 512MB

log = $(job_name).log
output = $(job_name).out
error = $(job_name).err

queue 